{
    "version": 2,
    "builds": [
        { "src": "main.py", "use": "@vercel/python" }
    ],
    "routes": [
        { "src": "/(.*)", "dest": "main.py" },
        {
            "src": "static/style.css",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            }
        }
    ]
}
